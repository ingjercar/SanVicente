@model IEnumerable<HospitalSanVicente.Models.Patient>
<a asp-controller="Appointment" asp-action="Index" class="btn btn-outline-warning"> Volver</a>
<div class="row">
    <div class="col-md-9">
        <table class="table table-borderless table-dark">
            <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Age</th>
                <th>Document</th>
                <th>Phone</th>
                <th>Email</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
            
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Age</td>
                    <td>@item.Document</td>
                    <td>@item.Phone</td>
                    <td>@item.Email</td>
                    <td>
                        <a class="btn btn-primary" asp-action="Details" asp-controller="Patient" asp-route-id="@item.Id">Details</a>
                        <a class="btn alert-danger" asp-action="Delete" asp-controller="Patient" asp-route-Id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create">
                    <div class="mt-3 d-flex flex-column">
                        <label >Name</label>
                        <input type="text" class="form-control" name="Name">
                    </div>
                    <div class="mt-3 d-flex flex-column">
                        <label >Document</label>
                        <input type="text" class="form-control" name="Document">
                    </div>                    
                    <div class="mt-3 d-flex flex-column">
                        <label >Age</label>
                        <input type="text" class="form-control" name="Age">
                    </div>
                    <div class="mt-3 d-flex flex-column">
                        <label >Phone</label>
                        <input type="number" class="form-control" name="Phone">
                    </div>
                    <div class="mt-3 d-flex flex-column">
                        <label >Email ida</label>
                        <input type="email" class="form-control" name="Email">
                    </div>
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <hr>
                    <button type="submit" class="btn btn-primary w-100">Save patient</button>
                </form>
            </div>
        </div>

    </div>

</div>
