@model IEnumerable<HospitalSanVicente.Models.Doctor>

<h1>List of Doctors</h1>
<div class="card-body">
    <form asp-action="Create">
        <div class="mt-3 d-flex flex-column">
            <label >Name</label>
            <input type="text" class="form-control" name="Name">
        </div>
        <div class="mt-3 d-flex flex-column">
            <label>CC</label>
            <input type="text" class="form-control" name="Document">
        </div>
        <div class="mt-3 d-flex flex-column">
            <label >Specialty</label>
            <input type="text" class="form-control" name="Specialty">
        </div>
        <div class="mt-3 d-flex flex-column">
            <label >Phone</label>
            <input type="text" class="form-control" name="Phone">
        </div>
        <div class="mt-3 d-flex flex-column">
            <label >Email</label>
            <input type="text" class="form-control" name="Email">
        </div>

        <hr>
        <button type="submit" class="btn btn-primary w-100">Add Doctor</button>
    </form>
</div>
<div>
    <table class="table table-borderless table-dark">
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Document</td>
                <td>@item.Specialty</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>

                <td>
                    <a class="btn btn-primary" asp-action="Details" asp-controller="Doctor" asp-route-id="@item.Id">Details</a>
                    <a class="btn alert-danger" asp-action="Delete" asp-controller="Doctor" asp-route-Id="@item.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>

    </table>
</div>